{
  "environment": {
    "name": "Fictional AcmeCloud staging environment",
    "nodes": [
      {
        "id": "internet",
        "label": "Public Internet",
        "kind": "internet"
      },
      {
        "id": "web",
        "label": "Public Web App",
        "kind": "compute"
      },
      {
        "id": "role",
        "label": "WebApp IAM Role",
        "kind": "role"
      },
      {
        "id": "db",
        "label": "Customer Database",
        "kind": "database",
        "sensitive": true
      },
      {
        "id": "bucket",
        "label": "Internal Reports Bucket",
        "kind": "bucket",
        "sensitive": true
      },
      {
        "id": "analyst",
        "label": "Analyst Identity",
        "kind": "user",
        "compromised": true
      },
      {
        "id": "readonly",
        "label": "ReadOnly Role",
        "kind": "role"
      },
      {
        "id": "secret",
        "label": "Production API Secret",
        "kind": "secret",
        "sensitive": true
      }
    ],
    "edges": [
      {
        "source": "internet",
        "target": "web",
        "permission": "reachable",
        "enabled": true
      },
      {
        "source": "web",
        "target": "role",
        "permission": "assume-role",
        "enabled": true
      },
      {
        "source": "role",
        "target": "db",
        "permission": "read",
        "enabled": true,
        "iam_action": "rds-db:connect",
        "iam_resource": "arn:aws:rds-db:us-east-1:111122223333:dbuser:demo/app"
      },
      {
        "source": "role",
        "target": "bucket",
        "permission": "read",
        "enabled": true,
        "iam_action": "s3:GetObject",
        "iam_resource": "arn:aws:s3:::internal-reports/*"
      },
      {
        "source": "analyst",
        "target": "readonly",
        "permission": "assume-role",
        "enabled": true
      },
      {
        "source": "readonly",
        "target": "secret",
        "permission": "read",
        "enabled": true,
        "iam_action": "secretsmanager:GetSecretValue",
        "iam_resource": "arn:aws:secretsmanager:us-east-1:111122223333:secret:production-api"
      },
      {
        "source": "role",
        "target": "secret",
        "permission": "read",
        "enabled": true,
        "iam_action": "secretsmanager:GetSecretValue",
        "iam_resource": "arn:aws:secretsmanager:us-east-1:111122223333:secret:production-api"
      }
    ]
  },
  "policies": {
    "role": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "rds-db:connect",
            "s3:GetObject",
            "secretsmanager:GetSecretValue"
          ],
          "Resource": "*"
        }
      ]
    },
    "readonly": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Deny",
          "Action": "secretsmanager:GetSecretValue",
          "Resource": "*"
        }
      ]
    }
  }
}